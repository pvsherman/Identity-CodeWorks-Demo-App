@page
@model DemoWebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Choose access";
    var ssoUrl = Url.Content("~/launch-sso");
}

<section class="login-shell">
    <div class="choice-panel">
        <div>
            <p class="eyebrow">Identity Manager access demo</p>
            <h1>Sales Command Center</h1>
            <p class="lede">Choose the access path you want to demonstrate. User access starts with OneLogin SSO, while administrator access uses AD credentials.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SsoError))
        {
            <div class="alert">@Model.SsoError</div>
        }

        <div class="choice-actions">
            @if (Model.UserLoginViaSSO)
            {
                <a class="primary-button" href="@ssoUrl">Log in as user</a>
            }
            else
            {
                <a class="primary-button" asp-page="/User">Log in as user</a>
            }
            <a class="secondary-button" asp-page="/Admin">Log in as admin</a>
        </div>
    </div>
</section>
