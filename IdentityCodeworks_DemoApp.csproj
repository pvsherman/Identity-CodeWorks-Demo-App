<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>IdentityCodeworks_DemoApp</AssemblyName>
    <RootNamespace>IdentityCodeworks_DemoApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UserSecretsId>e01adf7f-5cab-40e7-ac48-8e01d1919167</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ITfoxtec.Identity.Saml2.MvcCore" Version="4.21.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.14" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="publish\**" />
    <Content Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
    <Compile Remove="Tests\**\*.cs" />
  </ItemGroup>

</Project>
